// Shared, intentionally team-neutral build settings for all MACDancer targets.
// Select a signing team in Xcode on each developer machine; do not commit one here.

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 5.0
CLANG_ENABLE_MODULES = YES
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES

// Optional, untracked per-machine signing configuration.
#include? "Local.xcconfig"

// The single source of the app version. bin/make-release reads it, and the
// in-app updater compares it with the latest GitHub release.
MARKETING_VERSION = 2.0.0
CURRENT_PROJECT_VERSION = 2
