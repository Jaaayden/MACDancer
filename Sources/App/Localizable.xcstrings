    "daemon.message.incompatible" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The running service is from another build (protocol %1$d, this app uses %2$d). Repair connection loads the one inside this app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行的服务来自其他构建（协议 %1$d，本 App 使用 %2$d）。“修复连接”会加载本 App 内置的服务。"
          }
        }
      }
    },
    "daemon.message.not_installed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MACDancer needs its background service to change MAC addresses. Reading addresses works without it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改 MAC 地址需要后台服务；不安装也可以读取地址。"
          }
        }
      }
    },
    "daemon.message.ready" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes are applied by the background service and verified by reading the address back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改由后台服务执行，并通过读回地址来验证。"
          }
        }
      }
    },
    "daemon.message.unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service is installed but not answering (%@). Repair connection reloads it."
          }
