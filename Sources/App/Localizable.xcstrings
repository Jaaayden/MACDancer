          "stringUnit" : {
            "state" : "translated",
            "value" : "正在连接后台服务…"
          }
        }
      }
    },
    "daemon.message.incompatible" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The running service is from another build (protocol %1$d, this app uses %2$d). Repair connection loads the one inside this app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行的服务来自其他构建（协议 %1$d，本 App 使用 %2$d）。“修复连接”会加载本 App 内置的服务。"
          }
        }
      }
    },
    "daemon.message.ready" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes are applied by the background service and verified by reading the address back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改由后台服务执行，并通过读回地址来验证。"
          }
        }
      }
    },
    "daemon.message.unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service is installed but not answering (%@). Repair connection reloads it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务已安装但没有响应（%@）。“修复连接”会重新加载它。"
          }
        }
      }
    },
    "daemon.uninstall.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic rotation stops. Current MAC addresses, policies and history are kept, and no address is restored."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动轮换会停止。当前 MAC 地址、策略和历史记录都会保留，也不会恢复任何地址。"
          }
        }
      }
    },
    "daemon.uninstall.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uninstall the background service?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卸载后台服务？"
          }
        }
      }
    },
    "dashboard.interfaces.empty.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect an Ethernet adapter or turn on Wi-Fi, then refresh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接以太网适配器或打开 Wi-Fi，然后刷新。"
          }
        }
      }
    },
    "dashboard.interfaces.empty.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Wi-Fi or Ethernet interfaces"
          }
        },
        "zh-Hans" : {
