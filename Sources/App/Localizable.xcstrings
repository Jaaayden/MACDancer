    "disruption.wifi" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi drivers only accept a new address while disconnected. MACDancer will disconnect %@, change the address, and macOS will rejoin the network by itself. If Private Wi-Fi Address is on for that network, macOS may replace the new address when it rejoins."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi 驱动只在断开时接受新地址。MACDancer 会断开 %@、修改地址，之后 macOS 会自动重新加入网络。如果该网络开启了“私有 Wi-Fi 地址”，macOS 重新连接时可能会换掉新地址。"
          }
        }
      }
    },
    "disruption.wired" : {
