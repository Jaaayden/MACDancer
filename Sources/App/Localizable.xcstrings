          "stringUnit" : {
            "state" : "translated",
            "value" : "查看接口"
          }
        }
      }
    },
    "automation.configured.none" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None yet. “Randomize now” or the Policy menu on an interface turns it on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有。在接口上点“立即随机化”或从“策略”菜单开启。"
          }
        }
      }
    },
    "automation.configured.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interfaces with the random policy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用随机策略的接口"
          }
        }
      }
    },
    "automation.rule.route.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An interface with an IP address or the default route keeps its address until it is idle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 IP 地址或承载默认路由的接口，在空闲之前保持原地址。"
          }
        }
      }
    },
    "automation.rule.route.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interfaces in use are protected"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在使用的接口受到保护"
          }
        }
      }
    },
    "automation.rule.sleep.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before sleep MACDancer only records the pending rotation and lets the Mac sleep at once."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠前 MACDancer 只记录待处理的轮换，让 Mac 立即睡眠。"
          }
        }
      }
    },
    "automation.rule.sleep.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep is never delayed"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会拖慢睡眠"
          }
        }
      }
    },
    "automation.rule.wifi.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic rotation never disconnects Wi-Fi. It waits until Wi-Fi is off a network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动轮换永远不会断开 Wi-Fi，而是等到 Wi-Fi 不在任何网络上时再进行。"
          }
        }
      }
    },
    "automation.rule.wifi.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connected Wi-Fi is never touched automatically"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动化从不碰已连接的 Wi-Fi"
          }
        }
      }
    },
    "automation.setting.inactive.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an interface disconnects (for example Wi-Fi leaves a network), give it a new address before its next connection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接口断开时（例如 Wi-Fi 离开某个网络），在下一次连接前换一个新地址。"
          }
        }
      }
    },
    "automation.setting.inactive.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotate when an interface stops being used"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接口停止使用时轮换"
          }
        }
      }
    },
    "automation.setting.sleep.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queue a rotation as the Mac goes to sleep. Nothing is written until it wakes and the interface is safe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 进入睡眠时把轮换排进队列；唤醒且接口安全之前不会写入任何地址。"
          }
        }
      }
    },
    "automation.setting.sleep.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare a rotation before sleep"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠前准备轮换"
          }
        }
      }
    },
    "automation.setting.wake.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the Mac wakes, rotate each random-policy interface as soon as it is not in use."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 唤醒后，每个随机策略接口一旦不再使用就会轮换。"
          }
        }
      }
    },
    "automation.setting.wake.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotate after wake"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "唤醒后轮换"
          }
        }
      }
    },
    "automation.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotate addresses of interfaces with the random policy, without ever interrupting a connection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为使用随机策略的接口轮换地址，绝不打断正在使用的连接。"
          }
        }
      }
    },
    "automation.title" : {
