    "settings.private_wifi.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS can use its own private address per Wi-Fi network. When it is on, macOS may replace MACDancer’s address whenever it rejoins that network. Turn it off for networks where you want your own address."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 可以为每个 Wi-Fi 网络使用自己的私有地址。开启时，macOS 每次重新加入该网络都可能替换 MACDancer 设置的地址。想使用自己地址的网络，请把它关闭。"
          }
        }
      }
    },
