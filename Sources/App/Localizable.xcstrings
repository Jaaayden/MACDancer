      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow MACDancer in System Settings › General › Login Items & Extensions, then come back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置 › 通用 › 登录项与扩展”中允许 MACDancer，然后回到这里。"
          }
        }
      }
    },
    "daemon.message.checking" : {
